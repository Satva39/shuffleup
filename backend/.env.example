PORT=5000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/shuffleup
JWT_SECRET=your_secret_here
FRONTEND_URL=http://localhost:5173

EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
EMAILJS_VERIFICATION_TEMPLATE_ID=template_verification
EMAILJS_PASSWORD_RESET_TEMPLATE_ID=template_password_reset
# Public web app URL used for verification/reset links. Must be HTTPS in production.
PUBLIC_APP_URL=http://localhost:5173

# Optional: protect /api/performance-metrics with X-Metrics-Key. Leave unset to disable the endpoint.
METRICS_API_KEY=

# Optional OpenAI-compatible LLM for short, public-context-only bot reactions.
# Point this to a self-hosted/open-source compatible endpoint or leave disabled.
BOT_LLM_ENABLED=false
BOT_LLM_BASE_URL=http://127.0.0.1:11434
BOT_LLM_MODEL=your-local-chat-model
BOT_LLM_API_KEY=
BOT_LLM_TIMEOUT_MS=1800
BOT_REACTION_COOLDOWN_MS=6500

# Time before a disconnected human seat can be offered to an in-game bot.
BOT_TAKEOVER_GRACE_MS=45000
